{
  "expo": {
    "name": "CropBio",
    "slug": "cropbio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cropbio.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/cropbio.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "primaryColor": "#0A422D",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/cropbio.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nathanschiavon.cropbio"
    },
    "web": {
      "favicon": "./assets/cropbio.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "c373b68a-16e0-48c1-ad0c-96d2a759a77d"
      }
    },
    "owner": "nathanschiavon"
  }
}